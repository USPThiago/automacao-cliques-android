<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/modeIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/testModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/test_mode_switch"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <TextView style="@style/EditorSection" android:text="@string/section_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importSessionButton"
            style="@style/EditorAction"
            android:text="@string/import_session" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importTemplateButton"
            style="@style/EditorAction"
            android:text="@string/import_template" />

        <TextView style="@style/EditorSection" android:text="@string/section_export" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportSessionsButton"
            style="@style/EditorAction"
            android:text="@string/export_sessions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportTemplatesButton"
            style="@style/EditorAction"
            android:text="@string/export_templates" />

        <TextView style="@style/EditorSection" android:text="@string/section_move" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moveTestToMainButton"
            style="@style/EditorAction"
            android:text="@string/move_test_to_main" />

        <TextView style="@style/EditorHelp" android:text="@string/move_test_to_main_help" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moveMainToTestButton"
            style="@style/EditorAction"
            android:layout_marginTop="8dp"
            android:text="@string/move_main_to_test" />

        <TextView style="@style/EditorSection" android:text="@string/section_validate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/validateButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/validate_scripts" />

        <TextView style="@style/EditorSection" android:text="@string/section_edit" />

        <TextView
            android:id="@+id/editSessionsLink"
            style="@style/EditorLink"
            android:text="@string/link_edit_sessions" />

        <TextView
            android:id="@+id/viewTemplatesLink"
            style="@style/EditorLink"
            android:text="@string/link_view_templates" />
    </LinearLayout>
</ScrollView>
